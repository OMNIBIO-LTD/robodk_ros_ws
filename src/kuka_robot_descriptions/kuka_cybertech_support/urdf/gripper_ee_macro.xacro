<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    Self-contained gripper end-effector macro for the kuka_cybertech_support
    package. All mesh paths resolve against package://kuka_cybertech_support
    so the kuka description does not depend on any external package.

    Parameters:
      prefix : string prepended to all link/joint names (e.g. "" or "left_")
      parent : name of the parent link the gripper mounts to (e.g. "flange")
      *origin: xacro block specifying the mount transform (xyz/rpy)
  -->
  <xacro:macro name="gripper_ee" params="prefix parent *origin">

    <material name="${prefix}gripper_silver">
      <color rgba="0.700 0.700 0.700 1.000"/>
    </material>

    <joint name="${prefix}gripper_mount" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="${prefix}gripper_base_link"/>
    </joint>

    <link name="${prefix}gripper_base_link">
      <inertial>
        <origin xyz="-0.004489232637892108 -0.018469561788532624 -0.10694364852352554" rpy="0 0 0"/>
        <mass value="17.259498950839642"/>
        <inertia ixx="0.259724" iyy="0.197155" izz="0.153142" ixy="0.001156" iyz="0.058493" ixz="-0.00277"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://kuka_cybertech_support/meshes/gripper_ee/visual/base_link.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="${prefix}gripper_silver"/>
      </visual>
      <!-- main body (housing + actuator block, above the jaws) -->
      <collision>
        <origin xyz="-0.0065 -0.0965 -0.035" rpy="0 0 0"/>
        <geometry>
          <box size="0.198 0.297 0.120"/>
        </geometry>
      </collision>
      <!-- fixed jaw (thin bar on +Y side, extending down) -->
      <collision>
        <origin xyz="-0.007 0.0445 -0.244" rpy="0 0 0"/>
        <geometry>
          <box size="0.198 0.015 0.207"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}gripper_1">
      <inertial>
        <origin xyz="-1.0132789659417218e-09 -4.5049275015918155e-07 -0.13350000000000006" rpy="0 0 0"/>
        <mass value="6.5202017398676455"/>
        <inertia ixx="0.038861" iyy="0.061347" izz="0.022738" ixy="0.0" iyz="0.0" ixz="0.0"/>
      </inertial>
      <visual>
        <origin xyz="0.008 0.243458 0.08" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://kuka_cybertech_support/meshes/gripper_ee/visual/gripper_1.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="${prefix}gripper_silver"/>
      </visual>
      <!-- moving jaw modeled as a thin plate so gripping volume is open -->
      <collision>
        <origin xyz="0 0 -0.1335" rpy="0 0 0"/>
        <geometry>
          <box size="0.204 0.015 0.267"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}gripper_slider" type="prismatic">
      <origin xyz="-0.008 -0.243458 -0.08" rpy="0 0 0"/>
      <parent link="${prefix}gripper_base_link"/>
      <child link="${prefix}gripper_1"/>
      <axis xyz="0.0 1.0 0.0"/>
      <limit upper="0.25" lower="0.0" effort="3000" velocity="0.5"/>
      <dynamics damping="500.0" friction="200.0"/>
    </joint>

    <link name="${prefix}gripper_tcp"/>
    <joint name="${prefix}gripper_tcp_joint" type="fixed">
      <parent link="${prefix}gripper_base_link"/>
      <child link="${prefix}gripper_tcp"/>
      <origin xyz="0.0 0.0 -0.347" rpy="0 0 0"/>
    </joint>

  </xacro:macro>
</robot>
